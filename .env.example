# 本文件只提供变量名称，请勿填写真实密钥后提交。
YXRT_MODE=desktop
YXRT_HOST=127.0.0.1
YXRT_PORT=8765
YXRT_SESSION_HOURS=12
YXRT_OCR_WORKERS=0
YXRT_OCR_CPU_THREADS=0
YXRT_OCR_MAX_SIDE=2200
YXRT_OCR_WARMUP=0
YXRT_SYNC_INTERVAL=60
YXRT_UPDATE_REPOSITORY=3322810958-sudo/-
# 问题反馈：以下值均为可选；不配置时反馈仅保存在本机待发送队列。
# YXRT_QQ_SMTP_USER=你的QQ邮箱
# YXRT_QQ_SMTP_AUTH_CODE=QQ邮箱SMTP授权码
# YXRT_FEEDBACK_GITHUB_REPO=owner/private-feedback-repository
# YXRT_FEEDBACK_GITHUB_TOKEN=仅具备上述仓库Issues权限的令牌
# YXRT_COOKIE_SECURE=1
